NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/securedesk"
JWT_SECRET="REEMPLAZAR_POR_UN_SECRETO_SEGURO"
FRONTEND_ORIGIN="http://localhost:5173"

APP_VERSION="1.0.0"
BUILD_ID="local"

# Frase para cifrar los backups (minimo 20 caracteres, distinta en cada ambiente)
BACKUP_PASSPHRASE="REEMPLAZAR_POR_UNA_FRASE_LARGA"
# Opcional: carpeta en otro disco para la copia externa
BACKUP_OFFSITE_DIR=""
